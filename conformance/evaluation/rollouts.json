     "variationOrRollout": {"rollout": {"kind": "EXPERIMENT", "seed": 61, "weights": [{"variation": 1, "weight": 30000}, {"variation": 2, "weight": 30000}, {"variation": 0, "weight": 40000}]}}}],
    "fallthrough": {"variation": 0}},
   "overweight": {"key": "overweight", "version": 1, "on": true, "variations": [false, true],
