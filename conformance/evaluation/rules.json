  {"name": "ends with", "flag": "ops", "context": {"key": "u", "domain": "x.gov"}, "expect": {"value": "ends"}},
  {"name": "regex", "flag": "ops", "context": {"key": "u", "phone": "+919876543210"}, "expect": {"value": "regex"}},
  {"name": "regex no match", "flag": "ops", "context": {"key": "u", "phone": "+9198765"}, "expect": {"value": "none"}},
  {"name": "less than", "flag": "ops", "context": {"key": "u", "age": 17}, "expect": {"value": "lt"}},
  {"name": "number as string does not compare", "flag": "ops", "context": {"key": "u", "age": "17"}, "expect": {"value": "none"}},
  {"name": "greater or equal with decimals", "flag": "ops", "context": {"key": "u", "score": 99.5}, "expect": {"value": "gte"}},
  {"name": "before (RFC 3339 attribute)", "flag": "ops", "context": {"key": "u", "signupDate": "2019-06-30T10:00:00+05:30"}, "expect": {"value": "before"}},
  {"name": "before (epoch millis attribute)", "flag": "ops", "context": {"key": "u", "signupDate": 1546300800000}, "expect": {"value": "before"}},
  {"name": "after", "flag": "ops", "context": {"key": "u", "lastSeen": "2026-03-01T00:00:00Z"}, "expect": {"value": "after"}},
  {"name": "invalid date never matches", "flag": "ops", "context": {"key": "u", "lastSeen": "yesterday"}, "expect": {"value": "none"}},
  {"name": "semver greater", "flag": "ops", "context": {"key": "u", "appVersion": "2.10.0"}, "expect": {"value": "semver"}},
  {"name": "semver release beats pre-release", "flag": "ops", "context": {"key": "u", "appVersion": "2.4.0-rc.1"}, "expect": {"value": "none"}},
  {"name": "semver short form", "flag": "ops", "context": {"key": "u", "appVersion": "3"}, "expect": {"value": "semver"}},
  {"name": "array attribute matches any element", "flag": "ops", "context": {"key": "u", "groups": ["alpha", "beta"]}, "expect": {"value": "array"}},
  {"name": "nested attribute path", "flag": "ops", "context": {"key": "u", "address": {"city": "Pune"}}, "expect": {"value": "path"}},
  {"name": "organization kind in multi context", "flag": "ops", "context": {"kind": "multi", "user": {"key": "u"}, "organization": {"key": "o1", "plan": "enterprise"}}, "expect": {"value": "org"}},
  {"name": "missing kind does not match", "flag": "ops", "context": {"key": "u", "plan": "enterprise"}, "expect": {"value": "none"}},
  {"name": "negated clause", "flag": "ops", "context": {"key": "u", "role": "adviser"}, "expect": {"value": "negate"}},
  {"name": "negated clause excludes listed value", "flag": "ops", "context": {"key": "u", "role": "admin"}, "expect": {"value": "none"}},
  {"name": "missing attribute does not match even when negated", "flag": "ops", "context": {"key": "u"}, "expect": {"value": "none"}}
 ]
}
