{
 "description": "Clause operators, type strictness, negation, arrays, nested paths and multi-kind contexts",
 "snapshot": {
  "schemaVersion": 1,
  "flags": {
   "ops": {"key": "ops", "version": 1, "on": true, "variations": ["none", "in", "notin", "contains", "starts", "ends", "regex", "lt", "gte", "before", "after", "semver", "array", "path", "org", "negate", "unknown", "unsafe-regex"],
    "rules": [
     {"id": "r-unknown", "clauses": [{"attribute": "email", "op": "SOME_FUTURE_OP", "values": ["x"]}], "variationOrRollout": {"variation": 16}},
     {"id": "r-unsafe", "clauses": [{"attribute": "unsafe", "op": "MATCHES", "values": ["(?=a)a"]}], "variationOrRollout": {"variation": 17}},
     {"id": "r-in", "clauses": [{"attribute": "country", "op": "IN", "values": ["IN", "US"]}], "variationOrRollout": {"variation": 1}},
     {"id": "r-notin", "clauses": [{"attribute": "tier", "op": "NOT_IN", "values": ["free", "trial"]}], "variationOrRollout": {"variation": 2}},
     {"id": "r-contains", "clauses": [{"attribute": "email", "op": "CONTAINS", "values": ["@corp."]}], "variationOrRollout": {"variation": 3}},
     {"id": "r-starts", "clauses": [{"attribute": "name", "op": "STARTS_WITH", "values": ["Dr. "]}], "variationOrRollout": {"variation": 4}},
     {"id": "r-ends", "clauses": [{"attribute": "domain", "op": "ENDS_WITH", "values": [".gov"]}], "variationOrRollout": {"variation": 5}},
     {"id": "r-regex", "clauses": [{"attribute": "phone", "op": "MATCHES", "values": ["^\\+91[0-9]{10}$"]}], "variationOrRollout": {"variation": 6}},
     {"id": "r-lt", "clauses": [{"attribute": "age", "op": "LESS_THAN", "values": [18]}], "variationOrRollout": {"variation": 7}},
     {"id": "r-gte", "clauses": [{"attribute": "score", "op": "GREATER_THAN_OR_EQUAL", "values": [99.5]}], "variationOrRollout": {"variation": 8}},
     {"id": "r-before", "clauses": [{"attribute": "signupDate", "op": "BEFORE", "values": ["2020-01-01T00:00:00Z"]}], "variationOrRollout": {"variation": 9}},
     {"id": "r-after", "clauses": [{"attribute": "lastSeen", "op": "AFTER", "values": [1767225600000]}], "variationOrRollout": {"variation": 10}},
     {"id": "r-semver", "clauses": [{"attribute": "appVersion", "op": "SEMVER_GREATER_THAN", "values": ["2.4.0"]}], "variationOrRollout": {"variation": 11}},
     {"id": "r-array", "clauses": [{"attribute": "groups", "op": "IN", "values": ["beta"]}], "variationOrRollout": {"variation": 12}},
     {"id": "r-path", "clauses": [{"attribute": "/address/city", "op": "IN", "values": ["Pune"]}], "variationOrRollout": {"variation": 13}},
     {"id": "r-org", "clauses": [{"contextKind": "organization", "attribute": "plan", "op": "IN", "values": ["enterprise"]}], "variationOrRollout": {"variation": 14}},
     {"id": "r-negate", "clauses": [{"attribute": "role", "op": "IN", "values": ["admin"], "negate": true}, {"attribute": "role", "op": "STARTS_WITH", "values": ["ad"]}], "variationOrRollout": {"variation": 15}}
    ],
    "fallthrough": {"variation": 0}}
  }
 },
 "cases": [
  {"name": "unknown operator never matches", "flag": "ops", "context": {"key": "u", "email": "x"}, "expect": {"value": "none", "reason": {"kind": "FALLTHROUGH"}}},
  {"name": "lookahead regex is rejected", "flag": "ops", "context": {"key": "u", "unsafe": "a"}, "expect": {"value": "none"}},
  {"name": "in", "flag": "ops", "context": {"key": "u", "country": "IN"}, "expect": {"value": "in", "variation": 1, "reason": {"kind": "RULE_MATCH", "ruleId": "r-in", "ruleIndex": 2}}},
  {"name": "in is case sensitive", "flag": "ops", "context": {"key": "u", "country": "in"}, "expect": {"value": "none"}},
  {"name": "not in", "flag": "ops", "context": {"key": "u", "tier": "pro"}, "expect": {"value": "notin"}},
